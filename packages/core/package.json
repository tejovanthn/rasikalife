{
  "name": "@rasika/core",
  "version": "0.0.0",
  "description": "Core domain logic for Rasika.life Indian classical arts community platform",
  "main": "./src/index.ts",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts"
    },
    "./domain/edit/types": {
      "types": "./src/domain/edit/types.ts",
      "import": "./src/domain/edit/types.ts"
    },
    "./domain/artist/client": {
      "types": "./src/domain/artist/client.ts",
      "import": "./src/domain/artist/client.ts"
    },
    "./domain/raga/client": {
      "types": "./src/domain/raga/client.ts",
      "import": "./src/domain/raga/client.ts"
    },
    "./domain/tala/client": {
      "types": "./src/domain/tala/client.ts",
      "import": "./src/domain/tala/client.ts"
    },
    "./domain/composition/client": {
      "types": "./src/domain/composition/client.ts",
      "import": "./src/domain/composition/client.ts"
    },
    "./domain/edit/client": {
      "types": "./src/domain/edit/client.ts",
      "import": "./src/domain/edit/client.ts"
    },
    "./domain/change-history/client": {
      "types": "./src/domain/change-history/client.ts",
      "import": "./src/domain/change-history/client.ts"
    },
    "./domain/user/client": {
      "types": "./src/domain/user/client.ts",
      "import": "./src/domain/user/client.ts"
    },
    "./domain/content/client": {
      "types": "./src/domain/content/client.ts",
      "import": "./src/domain/content/client.ts"
    },
    "./domain/search/client": {
      "types": "./src/domain/search/client.ts",
      "import": "./src/domain/search/client.ts"
    },
    "./domain/*": {
      "types": "./src/domain/*/index.ts",
      "import": "./src/domain/*/index.ts"
    },
    "./shared/*": {
      "types": "./src/shared/*/index.ts",
      "import": "./src/shared/*/index.ts"
    },
    "./db": {
      "types": "./src/db/index.ts",
      "import": "./src/db/index.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "import": "./src/constants.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts"
    },
    "./types/entities": {
      "types": "./src/types/entities.ts",
      "import": "./src/types/entities.ts"
    },
    "./auth": {
      "types": "./src/auth/roles.ts",
      "import": "./src/auth/roles.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.987.0",
    "@aws-sdk/client-s3": "^3.987.0",
    "@aws-sdk/lib-dynamodb": "^3.987.0",
    "@aws-sdk/util-dynamodb": "^3.987.0",
    "@openauthjs/openauth": "^0.4.3",
    "electrodb": "^2.15.1",
    "fuse.js": "^7.1.0",
    "ksuid": "^3.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "@vitest/coverage-v8": "^1.6.1",
    "rimraf": "^5.0.10",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
