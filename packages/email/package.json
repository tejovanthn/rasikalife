{
  "name": "@rasika/email",
  "version": "0.0.0",
  "private": true,
  "description": "React Email templates for Rasika Classes, rendered to HTML + plain text for SES",
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx",
      "default": "./src/index.tsx"
    }
  },
  "scripts": {
    "dev": "email dev --dir emails --port 3010",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@rasika/core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "react-email": "^6.9.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
