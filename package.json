    "harfbuzzjs": "0.4.15",
    "hono": "^4.13.18",
    "sst": "^3.19.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tsconfig/node20": "^20.1.11",
    "@types/aws-lambda": "8.10.138",
    "esbuild": "^0.28.2",
    "globals": "^15.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
